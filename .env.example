# ---- Lead form ----
# The client already has an admin panel + database. When they provide the
# contact-form API, set these and every submission is POSTed there.
# Until set, leads append to data/leads.jsonl (dev fallback).
LEAD_API_URL=
LEAD_API_KEY=

# ---- Optional confirmation email (Resend) ----
# Only if the client wants the website to send the confirmation email itself.
# If unset, email is skipped (the client's admin can handle it).
RESEND_API_KEY=
LEAD_FROM_EMAIL="Blobex <hello@blobex.ca>"
LEAD_TEAM_EMAIL=contact@blobex.ca
